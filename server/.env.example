PORT=4600
MONGO_URI=mongodb://localhost:27017/agenda_turnos
CLIENT_URL=http://localhost:5600
# Otras direcciones desde las que se abre el front (separadas por coma), ej. un túnel
APP_ORIGINS=
TIMEZONE=America/Argentina/Buenos_Aires

# Firma de las sesiones del panel
JWT_SECRET=cambiar-esto-por-un-secreto-largo

# Google OAuth2 (login del panel + Google Calendar).
# Crear un "ID de cliente de OAuth" tipo "Aplicación web" en Google Cloud Console y
# agregar como URI de redireccionamiento autorizado: ${CLIENT_URL}/api/admin/auth/google/callback
# Mientras esté vacío, en desarrollo el panel ofrece un acceso sin Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cuentas de Google que pueden entrar al panel, separadas por coma
ADMIN_EMAILS=

# Email (SMTP). Si se deja vacío, los correos se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Espacio Prisma <no-reply@local.test>"
# Adónde llegan los avisos de señas nuevas
NOTIFY_EMAIL=admin@local.test

# Solo para `npm run seed`: calendarios de las profesionales, separados por coma.
# Vacío = el calendario principal de la cuenta de Google conectada.
SEED_CALENDAR_IDS=
